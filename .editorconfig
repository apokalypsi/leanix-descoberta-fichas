root = true

# Regra do projeto: UTF-8 em todo arquivo, sem BOM (ver .kiro/steering/encoding-utf8.md)
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Scripts de shell do Windows usam CRLF
[*.{ps1,bat,cmd}]
end_of_line = crlf

# Markdown: não cortar espaços de fim de linha (quebra "hard break" com 2 espaços)
[*.md]
trim_trailing_whitespace = false

# Java usa 4 espaços por convenção
[*.java]
indent_size = 4

# Makefile exige tabs
[Makefile]
indent_style = tab
