# Banco de dados (PostgreSQL)
POSTGRES_URL=jdbc:postgresql://localhost:5432/produtos
POSTGRES_USER=produtos
POSTGRES_PASSWORD=change-me

# Cache / idempotencia (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Mensageria (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Integracao externa (ViaCEP) — API publica, sem credencial
# VIACEP_BASE_URL=https://viacep.com.br

# Seguranca OAuth2 (Resource Server) — issuer do Authorization Server que emite o JWT.
# A API valida o token Bearer; scopes esperados: produtos:read e produtos:write.
OAUTH2_ISSUER_URI=https://auth.exemplo.com/realms/catalogo

SERVER_PORT=8080
