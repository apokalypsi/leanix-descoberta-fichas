# Variáveis de ambiente do MCP LeanIX (template)
# Copie este arquivo para `.env`, preencha os valores e NÃO versione o `.env`
# (o .gitignore da raiz já o bloqueia). O `.kiro/settings/mcp.json` lê estas duas variáveis.

# Subdomínio do seu workspace LeanIX.
# Ex.: se você acessa https://acme.leanix.net, o valor é "acme".
LEANIX_TENANT=seu-tenant

# Token de API do LeanIX (Administration > Technical Users / API Tokens).
# Segredo — nunca commite o valor real. Mantenha só no seu `.env` local.
LEANIX_API_TOKEN=cole-seu-token-aqui
