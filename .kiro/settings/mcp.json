{
  "mcpServers": {
    "leanix": {
      "type": "streamableHttp",
      "url": "https://${LEANIX_TENANT}.leanix.net/services/mcp-server/v1/mcp",
      "headers": {
        "Authorization": "Token ${LEANIX_API_TOKEN}"
      },
      "disabled": false,
      "autoApprove": [
        "search_mcp_tools",
        "get_mcp_tools_schema",
        "list_fact_sheets",
        "single_fact_sheet",
        "filter_inventory",
        "search_fact_sheet_by_name",
        "search_inventory",
        "get_workspace_context",
        "get_fact_sheet_types",
        "get_fact_sheet_details",
        "get_applications",
        "get_application_components",
        "count_fact_sheet_relations",
        "get_overview"
      ]
    }
  }
}